rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }
      function validProfile() {
        return request.resource.data.keys().hasOnly([
          'uid','name','email','heightCm','weightKg','goal',
          'sex','birthDate','bodyFatMeasuredPercent','setupComplete',
          'activityFactor','createdAt','updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.get('heightCm', null) == null || (request.resource.data.get('heightCm', null) is number && request.resource.data.get('heightCm', null) >= 80 && request.resource.data.get('heightCm', null) <= 250))
        && (request.resource.data.get('weightKg', null) == null || (request.resource.data.get('weightKg', null) is number && request.resource.data.get('weightKg', null) >= 20 && request.resource.data.get('weightKg', null) <= 350))
        && (request.resource.data.get('sex', null) == null || request.resource.data.get('sex', null) in ['male','female'])
        && (request.resource.data.get('birthDate', null) == null || request.resource.data.get('birthDate', null) is string)
        && (request.resource.data.get('goal', null) == null || request.resource.data.get('goal', null) is string)
        && (request.resource.data.get('bodyFatMeasuredPercent', null) == null || (request.resource.data.get('bodyFatMeasuredPercent', null) is number && request.resource.data.get('bodyFatMeasuredPercent', null) >= 2 && request.resource.data.get('bodyFatMeasuredPercent', null) <= 75))
        && request.resource.data.get('setupComplete', false) is bool
        && (request.resource.data.get('activityFactor', null) == null || (request.resource.data.get('activityFactor', null) is number && request.resource.data.get('activityFactor', null) >= 1.2 && request.resource.data.get('activityFactor', null) <= 2.0));
      }
      // Create profile only AFTER verification, on first verified login.
      allow create: if owner() && validProfile()
        && request.resource.data.get('setupComplete', false) == false;
      allow read: if owner();
      allow update: if owner() && validProfile()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owner();
    }
    // Daily journals. Every read/write belongs to a verified user.
    match /users/{userId}/meal_logs/{mealId} {
      function verifiedOwner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }
      function validMeal() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','mealType','calories','proteinGrams','carbsGrams','fatGrams','quantityGrams','dateKey','createdAt'])
          && d.keys().hasAll(['name','mealType','calories','proteinGrams','carbsGrams','fatGrams','dateKey','createdAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.mealType in ['breakfast','lunch','dinner','snack']
          && d.dateKey is string && d.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.calories is number && d.calories >= 0 && d.calories <= 10000
          && d.proteinGrams is number && d.proteinGrams >= 0 && d.proteinGrams <= 1000
          && d.carbsGrams is number && d.carbsGrams >= 0 && d.carbsGrams <= 1500
          && d.fatGrams is number && d.fatGrams >= 0 && d.fatGrams <= 1000
          && (!('quantityGrams' in d) || (d.quantityGrams is number && d.quantityGrams >= 0 && d.quantityGrams <= 10000))
          && d.createdAt == request.time;
      }
      allow read, delete: if verifiedOwner();
      allow create: if verifiedOwner() && validMeal();
      allow update: if false;
    }
    match /users/{userId}/water_logs/{waterId} {
      function verifiedOwner() {
        return request.auth != null && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }
      allow read, delete: if verifiedOwner();
      allow create: if verifiedOwner()
        && request.resource.data.keys().hasOnly(['amountMl','dateKey','createdAt'])
        && request.resource.data.keys().hasAll(['amountMl','dateKey','createdAt'])
        && request.resource.data.amountMl is int
        && request.resource.data.amountMl >= 1 && request.resource.data.amountMl <= 5000
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

  }
}
